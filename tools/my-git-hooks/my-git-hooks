#!/usr/bin/env bash

# Personal git wrapper with modular hooks

HOOKS_DIR="$DOTFILES/tools/my-git-hooks/hooks/"
REAL_GIT=$(command -v git)

if [[ -z "$REAL_GIT" ]]; then
    echo "Error: git not found" >&2
    exit 1
fi

# Prevent recursion
if [[ -n "$GIT_WRAPPER_ACTIVE" ]]; then
    exec "$REAL_GIT" "$@"
fi
export GIT_WRAPPER_ACTIVE=1

# === Run hooks ===
if [[ -d "$HOOKS_DIR" ]]; then
    for hook in "$HOOKS_DIR"/*; do
        [[ -f "$hook" && -x "$hook" ]] || continue
        if ! "$hook" "$@"; then
            echo "Aborted by hook: $hook" >&2
            exit 1
        fi
    done
fi

# Run real git
exec "$REAL_GIT" "$@"
