#!/usr/bin/env bash
# Hook: Block 'git push' on branches containing "local" in the name,
# and on any push involving a branch starting with "rename-branch/"
# (current branch, a branch/refspec argument, or --all/--branches/--mirror)

COMMAND="$1"

case "$COMMAND" in
    "push")
        # Block "rename-branch/" placeholders given as arguments (before the detached HEAD exit)
        REFUSED=""
        for ARG in "${@:2}"; do
            if [[ "$ARG" == *rename-branch/* ]]; then
                REFUSED="argument '$ARG'"
                break
            fi
            if [[ "$ARG" == "--all" || "$ARG" == "--branches" || "$ARG" == "--mirror" ]] \
                && [[ -n "$(command git for-each-ref --format='%(refname)' refs/heads/rename-branch/ 2>/dev/null || true)" ]]; then
                REFUSED="'$ARG' (a local 'rename-branch/' branch exists)"
                break
            fi
        done

        # Get current branch name
        CURRENT_BRANCH=$(command git branch --show-current 2>/dev/null || true)

        if [[ -z "$REFUSED" && "$CURRENT_BRANCH" =~ ^rename-branch/ ]]; then
            REFUSED="current branch '$CURRENT_BRANCH'"
        fi

        if [[ -n "$REFUSED" ]]; then
            echo "❌ ERROR: Cannot push: $REFUSED" >&2
            echo "   Branches starting with 'rename-branch/' are placeholders." >&2
            echo "" >&2
            echo "   Suggestions:" >&2
            echo "   • Rename the branch: git branch -m <new-name>" >&2
            exit 1
        fi

        if [[ -z "$CURRENT_BRANCH" ]]; then
            # Probably in detached HEAD state
            echo "⚠️ WARNING: You are in detached HEAD state. Push is allowed." >&2
            exit 0
        fi

        # Check if branch name contains "local" (case insensitive)
        if [[ "$CURRENT_BRANCH" =~ [Ll][Oo][Cc][Aa][Ll] ]]; then
            echo "❌ ERROR: Cannot push from branch '$CURRENT_BRANCH'" >&2
            echo "   Branch names containing 'local' are blocked from pushing." >&2
            echo "" >&2
            echo "   Suggestions:" >&2
            echo "   • Rename the branch: git branch -m new-name" >&2
            echo "   • Or push with a different branch: git push origin other-branch" >&2
            echo "   • Or temporarily force push if you really need to (not recommended): git push --no-verify" >&2
            exit 1
        fi
        ;;
esac

# Always succeed for other commands or allowed pushes
exit 0

